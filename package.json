{
  "name": "agent-quality-gate",
  "version": "1.1.2",
  "private": true,
  "description": "Locked Oxlint and Fallow quality gate for AI-assisted TypeScript and JavaScript workflows",
  "keywords": [
    "agent-quality-gate",
    "ai",
    "bun",
    "pi-package",
    "quality-gate",
    "typescript",
    "verify",
    "vibe-coding"
  ],
  "homepage": "https://github.com/greenhost87/agent-quality-gate",
  "bugs": {
    "url": "https://github.com/greenhost87/agent-quality-gate/issues"
  },
  "license": "MIT",
  "author": "greenhost87",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenhost87/agent-quality-gate.git"
  },
  "type": "module",
  "exports": {
    "./preset-runtime": "./gate/preset-runtime/preset-runtime.ts",
    "./verify": "./gate/public-verify/public-verify.ts",
    "./oxlint-rule-bench": "./scripts/oxlint-rule-bench/bench-create-once-rule.ts",
    "./oxlint-rule-bench/types": "./scripts/oxlint-rule-bench/bench-create-once-rule.ts",
    "./oxlint-rule-bench/create-bench-context": "./scripts/oxlint-rule-bench/create-bench-context.ts",
    "./oxlint-rule-bench/require-create-once-rule": "./scripts/oxlint-rule-bench/require-create-once-rule.ts",
    "./oxlint-rule-bench/hot-code": "./scripts/oxlint-rule-bench/hot-code.ts",
    "./oxlint-walk": "./scripts/oxlint-walk/oxlint-walk.ts",
    "./oxlint-walk/ast-index": "./scripts/oxlint-walk/ast-index.ts",
    "./apply-configured-rule": "./preset-catalog/oxlint-config/apply-configured-rule.ts",
    "./oxlint-config-types": "./preset-catalog/oxlint-config/write-oxlint-config.ts"
  },
  "scripts": {
    "build:release": "bun ./scripts/build-release/build-release-package.ts",
    "bench:baseline": "bun ./presets/baseline/tests/all/baseline.bench.ts",
    "bump-version": "bun ./scripts/bump-version/bump-version.ts",
    "collapse-types": "bun ./scripts/collapse-type-files/cli.ts",
    "fmt": "bun ./scripts/self-fmt/self-fmt.ts",
    "generate:project-skill": "bun ./scripts/generate-project-skill/cli.ts",
    "outdated": "bun ./scripts/outdated/outdated.ts",
    "verify": "bun ./scripts/self-verify/self-verify.ts",
    "verify:cwd": "bun ./scripts/verify-cwd/verify-cwd.ts",
    "aqg-install": "bun ./install.ts",
    "test": "bun ./scripts/self-test/self-test.ts",
    "self-aqg": "bun run fmt && bun run verify && bun run test && bun run test -- --integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oxlint/plugins": "1.82.0",
    "commander": "15.0.0",
    "fallow": "3.23.0",
    "mitata": "1.0.34",
    "oxc-parser": "0.149.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-eslint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.28",
    "typescript": "7.0.2",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "1.4.1",
    "oxfmt": "0.67.0",
    "testcontainers": "12.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "ssh2",
    "cpu-features"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi/extension.ts"
    ]
  },
  "trustedDependencies": []
}
