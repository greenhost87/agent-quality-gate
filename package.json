{
  "name": "agent-quality-gate",
  "version": "2.0.0",
  "private": true,
  "description": "Locked Oxlint and Fallow quality gate for AI-assisted TypeScript and JavaScript workflows",
  "keywords": [
    "agent-quality-gate",
    "ai",
    "bun",
    "pi-package",
    "quality-gate",
    "typescript",
    "verify",
    "vibe-coding"
  ],
  "homepage": "https://github.com/greenhost87/agent-quality-gate",
  "bugs": {
    "url": "https://github.com/greenhost87/agent-quality-gate/issues"
  },
  "license": "MIT",
  "author": "greenhost87",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenhost87/agent-quality-gate.git"
  },
  "type": "module",
  "imports": {
    "#package": "./package.json",
    "#system/*": "./system/*",
    "#adapters/*": "./adapters/*"
  },
  "exports": {
    "./internal/*": "./*",
    "./shared/verify": "./shared/verify.ts",
    "./shared/oxlint": "./shared/oxlint.ts",
    "./testing/oxlint": "./shared/tests/oxlint.ts"
  },
  "scripts": {
    "build:release": "bun ./system/scripts/build-release/build-release-package.ts",
    "bench:baseline": "bun ./presets/baseline/tests/all/baseline.bench.ts",
    "bump-version": "bun ./system/scripts/bump-version/bump-version.ts",
    "fmt": "bun ./system/scripts/self-fmt/self-fmt.ts",
    "generate:project-skill": "bun ./system/scripts/generate-project-skill/cli.ts",
    "verify": "bun ./system/scripts/self-verify/self-verify.ts",
    "verify:cwd": "bun ./system/scripts/verify-cwd/verify-cwd.ts",
    "aqg-install": "bun ./system/install/cli.ts",
    "test": "bun ./system/scripts/self-test/self-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:baseline": "tsc --noEmit -p presets/baseline/tsconfig.json",
    "self-aqg": "bun run fmt && bun run verify && bun run test && bun run test -- --integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@oxlint/plugins": "1.88.0",
    "commander": "15.0.0",
    "fallow": "3.33.1",
    "mitata": "1.0.34",
    "oxc-parser": "0.154.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-eslint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "1.3.37",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "testcontainers": "12.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0 || ^1.2.0",
    "@earendil-works/pi-tui": "^0.87.1 || ^1.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "ssh2",
    "cpu-features"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi/extension.ts"
    ]
  },
  "trustedDependencies": []
}
