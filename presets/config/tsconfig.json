{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./payload/*"],
      "agent-quality-gate/oxlint-rule-bench": [
        "../../scripts/oxlint-rule-bench/bench-create-once-rule.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/types": [
        "../../scripts/oxlint-rule-bench/bench-create-once-rule.types.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/create-bench-context": [
        "../../scripts/oxlint-rule-bench/create-bench-context.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/require-create-once-rule": [
        "../../scripts/oxlint-rule-bench/require-create-once-rule.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/hot-code": [
        "../../scripts/oxlint-rule-bench/hot-code.ts"
      ]
    }
  },
  "include": ["payload/**/*.ts", "tests/**/*.ts", "oxlint/**/*.ts"]
}
