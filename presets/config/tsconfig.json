{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./payload/*"]
    }
  },
  "include": ["gate-config.ts", "payload/**/*.ts", "tests/**/*.ts", "oxlint/**/*.ts"]
}
