{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "check.ts",
    "gate-config.ts",
    "parse-placement-config.ts",
    "parse-packages-config.ts",
    "parse-test-colocation-config.ts",
    "string-array-schema.ts",
    "scan-module-placement.ts",
    "scan-test-colocation.ts",
    "tests/**/*.ts",
    "oxlint/**/*.ts"
  ]
}
