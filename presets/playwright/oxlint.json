{
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["node_modules/**", ".*/**"],
  "jsPlugins": [
    {
      "name": "aqg",
      "specifier": "../baseline/oxlint/index.ts"
    },
    {
      "name": "playwright",
      "specifier": "./oxlint/playwright.ts"
    }
  ],
  "rules": {
    "aqg/no-inline-multiline-test-data": "error",
    "aqg/no-oxlint-disable-directives": "error",
    "playwright/e2e-runner": "error",
    "playwright/e2e-black-box": "error",
    "playwright/config": "error"
  }
}
