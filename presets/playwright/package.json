{
  "name": "@agent-quality-gate/preset-playwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --deny-warnings --config oxlint.json .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../system/scripts/self-test/run-preset-tests.ts tests",
    "verify": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
