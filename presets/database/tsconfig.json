{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@/system/config/*": ["../config/payload/system/config/*"],
      "@/system/database/connection": ["./payload/system/database/connection.ts"],
      "@/system/database/caches": ["./examples/system/database/caches.ts"],
      "@/system/database/orders/*": ["./examples/system/database/orders/*"],
      "@/tests/setup/*": ["./payload/tests/setup/*"],
      "@/*": ["./payload/*"]
    }
  },
  "include": [
    "payload/**/*.ts",
    "examples/**/*.ts",
    "fixture/**/*.ts",
    "tests/**/*.ts",
    "oxlint/**/*.ts",
    "build-examples-md.ts",
    "check.ts"
  ]
}
