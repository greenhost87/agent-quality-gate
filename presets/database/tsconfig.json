{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@/system/config/*": ["../config/payload/system/config/*"],
      "@/system/database/connection": ["./payload/system/database/connection.ts"],
      "@/system/database/caches": ["./examples/system/database/caches.ts"],
      "@/system/database/orders/*": ["./examples/system/database/orders/*"],
      "@/tests/setup/*": ["./payload/tests/setup/*"],
      "@/*": ["./payload/*"],
      "agent-quality-gate/oxlint-rule-bench": [
        "../../scripts/oxlint-rule-bench/bench-create-once-rule.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/types": [
        "../../scripts/oxlint-rule-bench/bench-create-once-rule.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/create-bench-context": [
        "../../scripts/oxlint-rule-bench/create-bench-context.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/require-create-once-rule": [
        "../../scripts/oxlint-rule-bench/require-create-once-rule.ts"
      ],
      "agent-quality-gate/oxlint-rule-bench/hot-code": [
        "../../scripts/oxlint-rule-bench/hot-code.ts"
      ]
    }
  },
  "include": [
    "payload/**/*.ts",
    "examples/**/*.ts",
    "fixture/**/*.ts",
    "tests/**/*.ts",
    "oxlint/**/*.ts",
    "build-examples-md.ts",
    "verify-committed-migrations.ts"
  ]
}
