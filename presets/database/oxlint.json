{
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["node_modules/**", ".*/**", "payload/**"],
  "jsPlugins": [
    {
      "name": "aqg",
      "specifier": "../baseline/oxlint/index.ts"
    },
    {
      "name": "database",
      "specifier": "./oxlint/dao-boundaries.ts"
    }
  ],
  "rules": {
    "aqg/no-inline-multiline-test-data": "error",
    "aqg/no-oxlint-disable-directives": "error",
    "database/dao-boundaries": "error",
    "database/test-database-boundaries": "error"
  },
  "overrides": [
    {
      "files": ["tests/database-runtime.integration.test.ts"],
      "rules": {
        "database/dao-boundaries": "off"
      }
    }
  ]
}
