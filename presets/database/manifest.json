{
  "name": "database",
  "requires": ["config"],
  "files": [
    {
      "destination": "system/database/connection.ts",
      "source": "payload/system/database/connection.ts"
    },
    {
      "destination": "system/database/migrate.ts",
      "source": "payload/system/database/migrate.ts"
    },
    {
      "destination": "tests/setup/testDatabase.ts",
      "source": "payload/tests/setup/testDatabase.ts"
    },
    {
      "destination": "tests/setup/testDatabase.bootstrap.ts",
      "source": "payload/tests/setup/testDatabase.bootstrap.ts"
    },
    {
      "destination": "tests/setup/fixtures/terminate-database-connections.sql",
      "source": "payload/tests/setup/fixtures/terminate-database-connections.sql"
    },
    {
      "destination": "scripts/sync-database-managed.ts",
      "source": "payload/scripts/sync-database-managed.ts",
      "exampleOnly": true
    },
    {
      "destination": "database-examples.md",
      "source": "payload/database-examples.md",
      "exampleOnly": true
    }
  ],
  "dependencies": [
    {
      "name": "@testcontainers/postgresql",
      "version": "12.0.4",
      "section": "devDependencies"
    },
    {
      "name": "testcontainers",
      "version": "12.0.4",
      "section": "devDependencies"
    }
  ],
  "ignoreScripts": ["ssh2", "cpu-features"],
  "oxlint": {
    "plugins": [
      {
        "name": "database",
        "specifier": "oxlint/dao-boundaries.ts"
      }
    ],
    "rules": {
      "database/dao-boundaries": { "severity": "error", "phase": "boundaries" },
      "database/test-database-boundaries": { "severity": "error", "phase": "boundaries" }
    }
  }
}
