{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "extensions/*/index.ts",
    "src/index.ts",
    "bin/*.ts",
    "reports/*.ts",
    "specs/**/*.ts"
  ],
  "project": [
    "extensions/**/*.ts",
    "src/**/*.ts",
    "bin/**/*.ts",
    "reports/**/*.ts",
    "specs/**/*.ts"
  ],
  "ignoreDependencies": [
    "prettier"
  ],
  "include": [
    "exports",
    "files",
    "dependencies",
    "unlisted",
    "unresolved",
    "duplicates",
    "types",
    "nsTypes",
    "classMembers",
    "enumMembers"
  ]
}
